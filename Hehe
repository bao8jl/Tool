local function StopFly()
	local State = FlyState
	FlyState = nil

	if FlyToggle then FlyToggle:SetValue(false) end
	if not State then return end

	for Index, Connection in State.Connections do
		Connection:Disconnect()
	end

	State.Gyro:Destroy()
	State.Velocity:Destroy()

	if State.Humanoid.Parent then
		State.Humanoid.PlatformStand = State.PlatformStand
	end
end

FlyToggle = MovementWindow:Toggle("Enabled Fly", false, function(Enabled)
	StopFly()
	if not Enabled then return end

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then return end

	local Gyro = Instance.new("BodyGyro")
	Gyro.P = 9e4
	Gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	Gyro.CFrame = RootPart.CFrame
	Gyro.Parent = RootPart

	local Velocity = Instance.new("BodyVelocity")
	Velocity.Velocity = Vector3.zero
	Velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	Velocity.Parent = RootPart

	local Control = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
	local Keys = {
		[Enum.KeyCode.W] = {"F", 1},
		[Enum.KeyCode.S] = {"B", -1},
		[Enum.KeyCode.A] = {"L", -1},
		[Enum.KeyCode.D] = {"R", 1},
		[Enum.KeyCode.E] = {"Q", 2},
		[Enum.KeyCode.Q] = {"E", -2},
	}

	local State = {
		Humanoid = Humanoid,
		PlatformStand = Humanoid.PlatformStand,
		Gyro = Gyro,
		Velocity = Velocity,
		Connections = {},
	}

	FlyState = State

	FlyToggle:SetValue(true)

	Humanoid.PlatformStand = true

	State.Connections[1] = UserInputService.InputBegan:Connect(function(Input, Processed)
		if Processed or UserInputService:GetFocusedTextBox() then return end

		local Key = Keys[Input.KeyCode]
		if Key then Control[Key[1]] = Key[2] end
	end)

	State.Connections[2] = UserInputService.InputEnded:Connect(function(Input)
		local Key = Keys[Input.KeyCode]
		if Key then Control[Key[1]] = 0 end
	end)

	State.Connections[3] = UserInputService.WindowFocusReleased:Connect(function()
		for Key, Value in Control do Control[Key] = 0 end
	end)

	State.Connections[4] = Humanoid.Died:Connect(StopFly)
	State.Connections[5] = Player.CharacterRemoving:Connect(function(RemovingCharacter)
		if RemovingCharacter == Character then StopFly() end
	end)

	State.Connections[6] = RunService.RenderStepped:Connect(function()
		if Player.Character ~= Character or not RootPart:IsDescendantOf(Character) or Humanoid.Health <= 0 then
			StopFly()
			return
		end

		local Camera = Workspace.CurrentCamera

		if not Camera then
			Velocity.Velocity = Vector3.zero
			return
		end

		local Forward = Control.F + Control.B
		local Side = Control.L + Control.R
		local Vertical = Control.Q + Control.E

		Humanoid.PlatformStand = true
		Velocity.Velocity = (Camera.CFrame.LookVector * Forward
			+ Camera.CFrame:VectorToWorldSpace(Vector3.new(Side, (Forward + Vertical) * 0.2, 0))) * FlySpeed
		Gyro.CFrame = Camera.CFrame
	end)
end)

