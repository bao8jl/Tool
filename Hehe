window2:Button("CFrame 1", function()
	local rootpart = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")

	if rootpart then
		local output1 = rootpart.CFrame
		local output2 = string.format("CFrame.new(%.1f, %.1f, %.1f)", output1.Position.X, output1.Position.Y, output1.Position.Z)

		setclipboard(output2)
	end
end)

window2:Box("CFrame 2", function(input1, input2)
	if not input1 then return end

	local x, y, z = string.match(input1, "CFrame%.new%(([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)")

	if x and y and z then
		plr.Character.HumanoidRootPart.CFrame = CFrame.new(tonumber(x), tonumber(y), tonumber(z))
	end
end)
