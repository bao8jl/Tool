local library = loadstring(game:HttpGet('https://raw.githubusercontent.com/liebertsx/Tora-Library/main/src/librarynew', true))()

local window1 = library:CreateWindow('Tools')
local window2 = library:CreateWindow('CFrame')

local folder1 = window1:AddFolder('Scripts')
local folder2 = window2:AddFolder('CFrame')

local plr = game.Players.LocalPlayer

folder1:AddButton({
	text = 'Infinite Yield',
	flag = 'btn_infiniteyield',
	callback = function()
		loadstring(game:HttpGet('https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source'))()
	end,
})

folder1:AddButton({
	text = 'RemoteSpy 1',
	flag = 'btn_remotespy1',
	callback = function()
		local owner = 'Upbolt'
		local branch = 'revision'

		local function webImport(file)
			return loadstring(game:HttpGetAsync(('https://raw.githubusercontent.com/%s/Hydroxide/%s/%s.lua'):format(owner, branch, file)), file .. '.lua')()
		end

		webImport('init')
		webImport('ui/main')
	end,
})

folder1:AddButton({
	text = 'RemoteSpy 2',
	flag = 'btn_remotespy2',
	callback = function()
		loadstring(game:HttpGet('https://github.com/notpoiu/cobalt/releases/latest/download/Cobalt.luau'))()
	end,
})

folder1:AddButton({
	text = 'Roblox Executor MCP',
	flag = 'btn_mcp',
	callback = function()
		getgenv().BridgeURL = 'localhost:16384'
		getgenv().DisableWebSocket = true
		getgenv().DisableInitialScriptDecompMapping = false

		loadstring(game:HttpGet('http://' .. (getgenv().BridgeURL or 'localhost:16384') .. '/script.luau'))()
	end,
})

folder2:AddButton({
	text = 'Copy CFrame',
	flag = 'btn_copy_cframe',
	callback = function()
		local char = plr and plr.Character
		local rootpart = char and char:FindFirstChild('HumanoidRootPart')

		if rootpart then
			local pos = rootpart.CFrame.Position
			setclipboard(('CFrame.new(%.1f, %.1f, %.1f)'):format(pos.X, pos.Y, pos.Z))
		end
	end,
})

folder2:AddList({
	text = 'Teleport CFrame',
	values = {},
	flag = 'tp_cframe',
	open = false,
	callback = function(value)
		if not value then return end

		local x, y, z = string.match(value, 'CFrame%.new%(([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)')

		if x and y and z then
			local char = plr and plr.Character
			local rootpart = char and char:FindFirstChild('HumanoidRootPart')

			if rootpart then
				rootpart.CFrame = CFrame.new(tonumber(x), tonumber(y), tonumber(z))
			end
		end
	end,
})

library:Init()
