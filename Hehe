ServerWindow:Button("Server Hop", function()
	if ServerHopping then return end
	ServerHopping = true

	local Success, Error = pcall(function()
		local Response = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"))
		local Servers = {}

		for Index, Server in Response.data do
			if Server.playing >= Server.maxPlayers or Server.id == game.JobId then continue end

			Servers[#Servers + 1] = Server.id
		end

		if #Servers == 0 then
			warn("Server Hop: Couldn't find a server.")
			return
		end

		TeleportService:TeleportToPlaceInstance(game.PlaceId, Servers[math.random(1, #Servers)], Player)
	end)

	ServerHopping = false
	if not Success then warn(Error) end
end)
