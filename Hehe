local function LoadScript(Url)
	local Success, Error = pcall(function()
		local Chunk, CompileError = loadstring(game:HttpGet(Url))
		if not Chunk then error(CompileError, 0) end

		Chunk()
	end)

	if not Success then warn(Error) end
	return Success
end

local function ToCFrame(Input)
	local InputType = typeof(Input)

	if InputType == "CFrame" then
		return Input
	elseif InputType == "Vector3" then
		return CFrame.new(Input)
	elseif InputType == "string" then
		local Kind, Coordinates = Input:match("^%s*(%w+)%.new%((.-)%)%s*$")
		if Kind and Kind ~= "CFrame" and Kind ~= "Vector3" then return end

		local X, Y, Z = (Coordinates or Input):match("^%s*([^,]+),%s*([^,]+),%s*([^,]+)%s*$")

		X, Y, Z = tonumber(X), tonumber(Y), tonumber(Z)
		if not X or not Y or not Z then return end

		return CFrame.new(X, Y, Z)
	elseif InputType == "Instance" then
		if Input:IsA("BasePart") then
			return Input.CFrame
		elseif Input:IsA("Model") then
			local HumanoidRootPart = Input:FindFirstChild("HumanoidRootPart")

			return HumanoidRootPart and HumanoidRootPart.CFrame or Input:GetPivot()
		end
	end
end

